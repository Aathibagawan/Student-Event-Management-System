# Copy to .env and fill in. NEVER commit .env
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. PostgreSQL URL format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Leave empty to use a local SQLite file (quick try-out only).
DATABASE_URL=
#postgresql://postgres:postgres@localhost:5432/ace_events
DB_SSL_REQUIRE=False

# The URL(s) where the React app runs (comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Serve uploaded files (posters) from Django. Fine for a demo; use S3/Cloudinary for real traffic.
SERVE_MEDIA=True

# Email: console backend prints emails in the terminal during development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ACE Events <no-reply@example.com>

# Optional: create demo users/events during deploy (build.sh). Set to False in real use.
SEED_DEMO_DATA=False
